# --- Secrets / credentials / keys (defense in depth) ---
# Anything resembling a private key, cert, or credential must NOT land here.
# Even though we don't currently carry any, listing the patterns guards future
# contributors against accidentally `git add -A`ing a stray .pem/.kube/.ssh.
*.pem
*.key
*.p12
*.pfx
*.der
*.crt
*.cer
*.p7b
*.p7c
*.keystore
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
known_hosts
authorized_keys
# Kubernetes / cloud client config & secrets
kubeconfig*
.kube/
.aws/
.gcloud/
.azure/
.ssh/
.netrc
.ghp.credentials
.ghe.credentials
# Generic "secret"-named files & dirs
*.secret
*.secrets
secrets/
credentials/
# Bare tokens accidentally dropped as files
*.token
*.tokens

# --- Agent / tooling caches ---
.serena/
.codegraph/
.claude/
.cursor/
.aider*
.continue/
.cody/
.windsurf/

# --- Project-local artefacts ---
.screenshots/
.worktrees/
.worktree/
# docs/ is intentionally untracked — scratch & iteration artifacts.
# README brand assets live in `assets/`.
docs/
*.tmp
*.temp
.tmp/
.temp/
# Ad-hoc Playwright debug / verification scripts (root + anywhere)
verify-*.mjs
# Root-level scratch scripts (e.g. _t.mjs)
_*.mjs

# --- Build / misc ---
*.tgz
.cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
out/
.superpowers
backend/data

# E2E specs ARE tracked — the repo had zero committed browser tests, which is
# how the `?context=` / `?cluster=` mismatch survived since `init`: every spec
# mocked the API and answered regardless of what it was asked for.
# Only the local scratch inspectors stay out (they target a hard-coded dev
# stack on :7003 and are not written for CI).
frontend/e2e/zz-*.spec.ts
frontend/e2e/logs.spec.ts
frontend/test-results/
frontend/e2e/.tmp/

# pnpm is the package manager (see frontend/README.md); pnpm-lock.yaml is the
# lockfile. A second one checked in is how the two drift and how someone ends
# up installing from a stale resolution.
frontend/package-lock.json

# Local audit tooling (visual README audit server) — dev-only, not shipped
.audit/
.playwright-mcp
.research
backend/.schemathesis/
backend/mutants/
backend/.hypothesis
backend/.coveragerc
# impeccable 的工具目录：配置和设计规范进版本库，运行时状态不进。
# design.json 是 DESIGN.md 的机器可读 sidecar（PRODUCT.md 里点名引用），
# config.json 记录 buildPath 决策 —— 丢一个就等于丢掉一个已确认的决定。
.impeccable/live/server.json
.impeccable/live/roots.json
.impeccable/live/sessions/
