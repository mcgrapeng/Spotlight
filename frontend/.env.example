# --- Vite dev server ---
# Override the host the dev server binds to. Default: 127.0.0.1 (local only).
# VITE_HOST=0.0.0.0
# Override the port the dev server listens on. Default: 5173.
# VITE_PORT=5173

# --- Dev-server proxy target ---
# Where /api and /healthz requests are forwarded. Default: http://127.0.0.1:8000
# (matches the backend default APP_PORT).
# VITE_API_PROXY=http://127.0.0.1:8000