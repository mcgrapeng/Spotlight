# --- Vite dev server ---
# Override the host the dev server binds to. Default: 127.0.0.1 (local only).
# VITE_HOST=0.0.0.0
# Preferred dev port. LEAVE UNSET to let Vite choose: it starts on its default
# and, if that port is busy, walks up to the next free one automatically.
# Vite prints the URL it actually bound — open that, don't assume 5173.
# VITE_PORT=5173

# Playwright's preview server. Unlike the dev server this one does NOT
# auto-increment: Playwright navigates to a fixed baseURL, so a silently
# shifted port would look like every test failing at once. It fails loudly
# instead. Override only if 4173 is taken on your machine.
# VITE_PREVIEW_PORT=4173

# --- Dev-server proxy target ---
# Where /api and /healthz requests are forwarded — this is the BACKEND, and it
# must match the port uvicorn was started on. Default: http://127.0.0.1:8000
# (uvicorn's own default). If you start the backend with `--port 8002`, set this
# to http://127.0.0.1:8002 or the frontend will silently proxy to a dead port.
# VITE_API_PROXY=http://127.0.0.1:8000
