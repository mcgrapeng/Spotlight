# --- K8s / kubeconfig ---
# Path to the kubeconfig tsh should write to. Leave empty to use $KUBECONFIG
# or ~/.kube/config. The K8s client pool reads from this same path.
# KUBECONFIG_PATH=
# K8S_REQUEST_TIMEOUT=15

# --- Teleport (tsh) ---
# Required for /login to work. All values are read by pydantic-settings at
# app startup; nothing here is hardcoded in code.
# TELEPORT_PROXY=proxy.example.com:443
# TELEPORT_USER=
# TELEPORT_CLUSTER=
# TELEPORT_AUTH=local
# Set true only for self-signed proxies (lab/dev).
# TELEPORT_INSECURE=false
# Optional. Path to the tsh binary. Defaults to "tsh" (on $PATH).
# TSH_BINARY=tsh

# --- Unattended auto-login (optional) ---
# If set, the backend runs `tsh login` at startup with this password so
# kubeconfig is populated before the first request. Leave UNSET in dev — the
# /login form is the safer path. If you must use it, prefer a sealed-secret /
# vault-agent injector over a plain file. NEVER commit a real password.
# TELEPORT_AUTOLOGIN_PASSWORD=

# --- Database ---
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- CORS ---
# Comma-separated origins. Default covers the two local Vite ports.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cache TTLs (seconds). 0 disables. ---
# CACHE_TTL_PODS=5
# CACHE_TTL_NODES=30
# CACHE_TTL_EVENTS=10
# CACHE_TTL_NAMESPACES=60

# --- App ---
# APP_NAME=spotlight
# APP_HOST=0.0.0.0
# APP_PORT=8000
# LOG_LEVEL=INFO
# DEBUG=true
