# --- K8s / kubeconfig ---
# Path to the kubeconfig tsh should write to. Leave empty to use $KUBECONFIG
# or ~/.kube/config. The K8s client pool reads from this same path.
# KUBECONFIG_PATH=
# K8S_REQUEST_TIMEOUT=15

# --- Teleport (tsh) ---
# Required for /login to work. The username is supplied per-session by the
# login form (no server-wide TELEPORT_USER). All values are read by
# pydantic-settings at app startup; nothing here is hardcoded in code.
# TELEPORT_PROXY=proxy.example.com:443
# TELEPORT_CLUSTER=
# TELEPORT_AUTH=local
# Set true only for self-signed proxies (lab/dev).
# TELEPORT_INSECURE=false
# Optional. Path to the tsh binary. Defaults to "tsh" (on $PATH).
# TSH_BINARY=tsh

# --- Active auth provider ---
# Which plugin REGISTRY entry is the live login flow. Pick one of:
#   "teleport" — per-session tsh login via TeleportPlugin (Task 4+)
#   "token"    — shared API_TOKEN check via TokenPlugin
# Empty string = dev open mode (no auth required, /api/v1/* unprotected).
# AUTH_PROVIDER=teleport

# --- API access ---
# When set, every /api/v1 route (except /auth/status and /auth/login)
# requires `Authorization: Bearer <API_TOKEN>` or a session cookie issued by
# /auth/login. With Teleport configured, the login form issues sessions; the
# token is for scripts/curl and host-bound deployments (present it in the
# login form's password field). Leave BOTH this and TELEPORT_* unset only
# for local dev — the API is then open and the app logs a startup warning.
# API_TOKEN=

# --- Database ---
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- CORS ---
# Comma-separated allowed origins. LEAVE UNSET for local dev: the app then
# allows any port on localhost/127.0.0.1, so the frontend can move ports
# without touching this file. (In dev the frontend proxies /api through Vite,
# so CORS rarely fires at all — this is a safety net for direct browser calls.)
# Set it explicitly in production, and never use localhost there.
# CORS_ORIGINS=https://spotlight.example.com

# --- Cache TTLs (seconds). 0 disables. ---
# CACHE_TTL_PODS=5
# CACHE_TTL_NODES=30
# CACHE_TTL_EVENTS=10
# CACHE_TTL_NAMESPACES=60

# --- App ---
# APP_NAME=spotlight
# LOG_LEVEL=INFO
